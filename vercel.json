{
  "outputDirectory": "public",
  "functions": {
    "api/research.py": {
      "maxDuration": 300,
      "includeFiles": "finn/**"
    },
    "api/ask.py": {
      "maxDuration": 30,
      "includeFiles": "finn/**"
    },
    "api/brief.py": {
      "maxDuration": 30,
      "includeFiles": "{finn/**,public/data/**}"
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}